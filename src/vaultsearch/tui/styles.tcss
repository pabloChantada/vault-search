/* vaultsearch TUI: ink on washi paper, like the 3D map.
   Colours come from the Textual themes in themes.py (palette in vaultsearch/theme.py):
   $ink text, $ash diluted ink, $ai indigo, $moss green, $seal vermilion, $paper, $paper-deep.
   The seal colour only ever marks where you are: the focused pane, the cursor, matched words. */

Screen {
    background: $paper;
    color: $ink;
    padding: 1 2 0 2;
}

/* ---------- brand line: name, vault, and the seal that shows the index state ---------- */
#brand {
    height: 1;
    margin-bottom: 1;
}

#title {
    width: 1fr;
}

#seal {
    width: auto;
    background: $seal;
    color: $paper;
    text-style: bold;
}

#seal.busy {
    background: $ash;
}

/* ---------- search ---------- */
#prompt {
    height: 2;
    padding: 0;
    border: none;
    border-bottom: hkey $ash;
    background: $paper;
    background-tint: $paper 0%;
    color: $ink;
}

#prompt:focus {
    background-tint: $paper 0%;
    border: none;
    border-bottom: hkey $seal;
}

#prompt > .input--placeholder,
#prompt > .input--suggestion {
    color: $ash;
}

#scope {
    height: 1;
    margin-top: 1;
}

/* ---------- results | note ---------- */
#main {
    height: 1fr;
    margin-top: 1;
}

#results {
    width: 2fr;
    min-width: 30;
    max-width: 64;
    background: $paper;
    border-left: blank;
    padding-right: 2;
}

#results:focus {
    border-left: outer $seal;
}

#results > ListItem {
    padding: 0 1;
    margin-bottom: 1;
    background: $paper;
}

#results > ListItem.-highlight {
    background: $paper-deep;
}

#results:focus > ListItem.-highlight .r-head {
    text-style: underline;
}

.r-body {
    color: $ash;
    max-height: 2;
    text-overflow: ellipsis;
}

#note {
    width: 3fr;
    padding: 0 2;
    border-left: vkey $paper-deep;
    background: $paper;
    scrollbar-size-vertical: 1;
    scrollbar-gutter: stable;  /* a long note must not narrow the page it was wrapped for */
}

#note:focus {
    border-left: outer $seal;
}
/* ---------- status line ---------- */
#statusbar {
    height: 1;
    margin-top: 1;
}

#status {
    width: 1fr;
}

#keys {
    width: auto;
}

/* ---------- pop-ups ---------- */
ShortcutsScreen, ActivityScreen {
    align: center middle;
    background: $paper 60%;
}

#sheet {
    width: 96;
    max-width: 100%;
    height: auto;
    max-height: 90%;
    padding: 1 3;
    background: $paper;
    border: solid $ink;
}

#sheet.activity {
    height: 80%;
}

.sheet-title {
    margin-bottom: 1;
}

#sheet-grid {
    grid-size: 2;
    grid-gutter: 1 4;
    height: auto;
}

.sheet-section {
    height: auto;
}

.sheet-hint {
    margin-top: 1;
}

#activity-log {
    height: 1fr;
    background: $paper;
    color: $ink;
}

/* ---------- Textual's own pop-ups ---------- */
CommandPalette > Vertical {
    background: $paper;
}

Toast {
    background: $paper-deep;
    color: $ink;
}
